{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:proofgap-x:schema:case:1.0",
  "title": "ProofGap X case input, schema version 1.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "caseId", "title", "sources", "claims", "evidence"],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "caseId": { "$ref": "#/$defs/id" },
    "title": { "$ref": "#/$defs/text" },
    "sources": { "type": "array", "maxItems": 1000, "items": { "$ref": "#/$defs/source" } },
    "claims": { "type": "array", "maxItems": 500, "items": { "$ref": "#/$defs/claim" } },
    "evidence": { "type": "array", "maxItems": 5000, "items": { "$ref": "#/$defs/evidence" } }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[A-Za-z0-9_.-]{1,64}$" },
    "text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000,
      "pattern": "^[^\\u0000-\\u0008\\u000b\\u000c\\u000e-\\u001f\\u007f\\u202a-\\u202e\\u2066-\\u2069]*$"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "name": { "$ref": "#/$defs/text" },
        "originGroup": { "$ref": "#/$defs/id" },
        "derivedFrom": { "type": "array", "maxItems": 50, "items": { "$ref": "#/$defs/id" } }
      }
    },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "statement"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "statement": { "$ref": "#/$defs/text" }
      }
    },
    "link": {
      "type": "object",
      "additionalProperties": false,
      "required": ["claimId", "stance", "strength"],
      "properties": {
        "claimId": { "$ref": "#/$defs/id" },
        "stance": { "enum": ["supports", "contradicts"] },
        "strength": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "sourceId", "description", "links"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "sourceId": { "$ref": "#/$defs/id" },
        "description": { "$ref": "#/$defs/text" },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "links": { "type": "array", "maxItems": 50, "items": { "$ref": "#/$defs/link" } }
      }
    }
  }
}
